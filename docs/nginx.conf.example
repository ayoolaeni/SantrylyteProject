# Reference nginx config for terminating HTTPS in front of SentryLite (NFR5.11).
# SentryLite itself only ever speaks plain HTTP/WebSocket; TLS termination,
# certificate management and the Secure cookie flag on the session cookie all
# depend on this (or an equivalent) reverse proxy sitting in front of it.
#
# Once this is in place, run the app with SESSION_COOKIE_SECURE unset (defaults
# to true under FLASK_ENV=production) so the browser only ever sends the session
# cookie over the HTTPS connection terminated here.

server {
    listen 443 ssl http2;
    server_name sentrylite.example.com;

    ssl_certificate     /etc/letsencrypt/live/sentrylite.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentrylite.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass         http://127.0.0.1:5000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Socket.IO's /socket.io/ path needs the Upgrade/Connection headers forwarded
    # so the WebSocket transport can negotiate (it falls back to polling otherwise).
    location /socket.io/ {
        proxy_pass         http://127.0.0.1:5000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    server_name sentrylite.example.com;
    return 301 https://$host$request_uri;
}

# The syslog UDP/TCP listener (default port 5514) is not HTTP and is not proxied
# here — expose it directly (e.g. via a firewall rule scoped to trusted log
# sources) or place it behind a TCP/UDP load balancer if you run multiple nodes.
